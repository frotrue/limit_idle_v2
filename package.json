{
  "name": "limit-idle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite preview",
    "test": "node --test tests/polynomial.test.js tests/facades.test.js tests/stabilityPatches.test.js tests/decimalPowCache.test.js tests/buyMaxOtherUpgrade.test.js tests/saveSerializer.test.js tests/simulateOptions.test.js tests/balanceFormulas.test.js",
    "sim": "node scripts/simulate.js",
    "sim:10m": "node scripts/simulate.js --minutes=10",
    "sim:1h": "node scripts/simulate.js --hours=1",
    "sim:24h": "node scripts/simulate.js --hours=24 --long-run --purchase-every=600 --event-limit=200 --max-real-seconds=120",
    "sim:check": "node scripts/simulate.js --hours=1 --expect=firstDifferentiation:8m:12m --expect=expUnlocked:15m:30m --expect=firstExp:25m:35m --expect=firstResearch:20m:35m",
    "android:sync": "npm run build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.0",
    "break_eternity.js": "^2.1.3",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.28"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "vite": "^8.0.16"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
